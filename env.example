# Never commit your real bot token.
DISCORD_TOKEN=replace-with-your-bot-token

# Optional: your Discord server ID for near-instant command updates while testing.
TEST_GUILD_ID=

LOG_LEVEL=INFO

# Optional ticket routing. These defaults match the Discord category/role names.
TICKET_SUPPORT_CATEGORY_NAME=Support Tickets
TICKET_PARTNERSHIP_CATEGORY_NAME=Partnership Requests
TICKET_STAFF_PING_ROLE=Staff Team
PARTNERS_CHANNEL_NAME=partners

# Automatic partnership verification. Keep the tier list empty until the real
# member ranges, required proof pings and Density Discord roles are confirmed.
PARTNER_TIERS_FILE=/data/partner-tiers.json
PARTNER_PING_TIERS_JSON=
PARTNER_VISION_MODEL=gpt-5-mini

# Arcane-style chat levels. Level-up messages are posted here.
SPECIAL_RANKS_CHANNEL=special-ranks
LEVEL_XP_COOLDOWN=45
LEVEL_XP_MIN=15
LEVEL_XP_MAX=25
BOT_UPDATES_CHANNEL=bot-updates
SOCIAL_LINKS_CHANNEL=links

# Staff command guide, punishments and five-day activity checks.
STAFF_COMMANDS_CHANNEL=staff-commands
STAFF_ACTIVITY_CHANNEL=staff-activity
STAFF_PUNISHMENTS_CHANNEL=staff-punishments
STAFF_ACTIVITY_PING_ROLE=Staff Team
STAFF_ACTIVITY_INTERVAL_SECONDS=432000
STAFF_ACTIVITY_WINDOW_SECONDS=86400
BOT_TIMEZONE=Europe/London

# Partner Manager staff applications. The bot creates/refreshes the panel and
# private review channels automatically when it starts.
STAFF_APPLICATION_PANEL_CHANNEL=application-for-staff
STAFF_APPLICATION_CATEGORY=Applications
STAFF_APPLICATION_PENDING_CHANNEL=pending
STAFF_APPLICATION_ACCEPTED_CHANNEL=accepted
STAFF_APPLICATION_DENIED_CHANNEL=denied
PARTNER_MANAGER_ROLE=Partner Manager
STAFF_TEAM_ROLE=Staff Team
STAFF_APPLICATION_REAPPLY_DAYS=14

# DonutSMP player stats for !stats IGN. Create this key in-game with /api.
DONUT_API_KEY=
DONUT_STATS_API_URL=https://api.donutsmp.net/v1/stats/{ign}

# Smart conversation: mention Density Bot or reply to one of its messages.
# Create a project API key at https://platform.openai.com/api-keys and keep it private.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_CHAT_ENABLED=true
AI_MEMORY_MINUTES=30
AI_COOLDOWN_SECONDS=5
AI_MAX_INPUT_CHARS=1800
AI_MAX_OUTPUT_TOKENS=600
AI_TIMEOUT_SECONDS=45
AI_KNOWLEDGE_DB=/data/ai-knowledge.sqlite3
AI_LEARN_CHANNELS=announcements,rules,faq,information,server-info,links,updates,bot-updates
AI_LEARN_ROLE_NAMES=Owner,Co Owner,Co-Owner,Manager,Admin,Moderator,Staff Team,Staff
AI_LEARN_EXCLUDED_WORDS=staff,ticket,transcript,logs,punishment,application,admin,moderation,private,appeal,report,claim,api
AI_LEARN_BACKFILL_MESSAGES=75
AI_KNOWLEDGE_RESULTS=6
AI_KNOWLEDGE_MAX_ROWS=5000
AI_KNOWLEDGE_RETENTION_DAYS=180
